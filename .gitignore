# Nothing derived from the imaging data belongs in this repository.
# The source dataset is 392.7 GB of CZI; the derived outputs are ~20 GB.

# Source and derived image data
*.czi
*.zip
*.tif
*.tiff
*.png
*.npy
overviews/
contactsheets/
qc/
triage/
template/
registered/
qupath/
results/
logs/

# Atlas plates are extracted from Salmon Atlas.pdf - 107 MB, and not ours to
# redistribute. The extraction script is here; run it against your own copy.
atlas/

# Working directories: Bio-Formats memo caches, the Python 3.13 venv, extracted CZIs
work/

# Machine-specific: absolute paths and the marker-identity assignment.
# Commit config.example.json instead.
config.json
# ...and anything beside it: the atomic writer's .tmp, and the backups
# a migration leaves. None of them may reach a public repo - config.json
# holds absolute paths and, for now, the unblinding key.
config.json.*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# OS
Thumbs.db
.DS_Store
desktop.ini
artifacts/

# Colab: the notebook and its module ARE source and are tracked.
# Only run outputs are not.
colab/out/
colab/*.csv
censor/

# Desktop app build output
build/
dist/

# Self-test output, written beside the executable at run time
lsapp-selftest.log
lsapp-crash.log

# Generated by tests/run.sh - the curator's JS, lifted from the built page
tests/build/

# Generated from the .md by pandoc; the markdown is the source.
docs/*.docx
docs/*.pdf

# Virtual environments and compiled binaries
work/czienv/
**/czienv/
*.pyd
*.exe
*.dll
*.lib
*.pyc
__pycache__/

# Image and array data (too large for git)
*.tif
*.tiff
*.npy
*.npz
*.png

# Local backups, logs and keys
*.backup
*.pre_new_atlas
*.log
*.pfx
*.pem
